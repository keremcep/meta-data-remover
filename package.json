  "author": "keremcep",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keremcep/meta-data-remover.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "multer": "^2.4.0"
  }
}
