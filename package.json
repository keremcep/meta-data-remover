{
  "name": "meta-data-remover",
  "version": "1.0.0",
  "description": "Office belgelerinin (docx/xlsx/pptx) metadata'sını görüntüleyen, düzenleyen ve temizleyen yerel web aracı",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node test/smoke.mjs"
